# ---------------------------------------------------------------------------
# Version-Aware Clinical Terminology Standardizer -- example configuration
# Copy to `.env` and edit. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL (started by ./docker-compose.yml) ---
POSTGRES_DB=terminology
POSTGRES_USER=terminology
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend, Alembic and the scripts.
DATABASE_URL=postgresql+psycopg://terminology:change-me-locally@localhost:5432/terminology

# --- Snowstorm terminology server (started by infra/snowstorm/docker-compose.yml) ---
SNOWSTORM_BASE_URL=http://localhost:8080
SNOWSTORM_BRANCH=MAIN
SNOWSTORM_TIMEOUT_SECONDS=30

# --- Application ---
APP_NAME=Version-Aware Clinical Terminology Standardizer
LOG_LEVEL=INFO
DATA_RAW_DIR=data/raw
REPORTS_DIR=data/reports

# Safety limit when chasing a replacement chain (LOINC MapTo / SNOMED history).
MAX_REPLACEMENT_CHAIN_DEPTH=10
