# Normalise line endings so a Windows/macOS/Linux team sees the same diffs.
* text=auto eol=lf

# Windows-native scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.zip  binary
*.gz   binary
*.tgz  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.db   binary
